<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1">

<title>Narf Store</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    color-scheme: dark;

    --black: #000000;
    --panel: #090909;
    --panel-2: #101010;
    --border: #242424;

    --white: #ffffff;
    --text: #f5f5f7;
    --muted: #8e8e93;

    --orange: #ff7a00;
    --orange-bright: #ff8a00;
}

html {
    background: #000;
}

body {
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "SF Pro Display",
        "Helvetica Neue",
        sans-serif;

    background: #000;
    color: var(--text);

    min-height: 100vh;
    padding: 18px;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input {
    font-family: inherit;
}

.page {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
}


/* =========================================================
   HEADER
========================================================= */

.topbar {
    height: 58px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 12px;
}

.brand {
    display: flex;
    align-items: center;

    gap: 10px;

    font-size: 20px;
    font-weight: 850;
    letter-spacing: -0.4px;
}

.brand img {
    width: 38px;
    height: 38px;

    border-radius: 10px;

    object-fit: cover;

    background: #111;

    border: 1px solid #242424;
}

.brand-name {
    color: #fff;
}

.account-area {
    display: flex;
    align-items: center;
}

.account-button {
    width: 40px;
    height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #0b0b0b;

    border: 1px solid #292929;

    color: #fff;

    cursor: pointer;

    transition: .18s ease;
}

.account-button:hover {
    border-color: var(--orange);

    box-shadow:
        0 0 0 3px rgba(255,122,0,.08);
}

.account-icon {
    width: 20px;
    height: 20px;

    opacity: .9;
}


/* =========================================================
   SEARCH
========================================================= */

.search-area {
    margin-bottom: 22px;
}

.search-box {
    width: 100%;

    display: flex;
    align-items: center;

    height: 48px;

    background: #090909;

    border: 1px solid #292929;

    border-radius: 15px;

    overflow: hidden;

    transition: .18s ease;
}

.search-box:focus-within {
    border-color: rgba(255,122,0,.75);

    box-shadow:
        0 0 0 3px rgba(255,122,0,.07);
}

.search-input {
    flex: 1;

    height: 100%;

    padding: 0 15px;

    border: 0;
    outline: 0;

    background: transparent;

    color: #fff;

    font-size: 14px;
}

.search-input::placeholder {
    color: #707070;
}

.search-button {
    width: 42px;
    height: 42px;

    margin-right: 3px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 0;

    border-radius: 50%;

    background: var(--orange);

    color: #000;

    cursor: pointer;

    flex-shrink: 0;

    transition: .18s ease;
}

.search-button:hover {
    background: var(--orange-bright);

    transform: scale(1.03);
}

.search-icon {
    width: 18px;
    height: 18px;

    stroke: currentColor;

    stroke-width: 2.5;

    fill: none;
}


/* =========================================================
   FEATURED STORE
========================================================= */

.featured {
    margin-bottom: 25px;
}

.featured-head {
    display: flex;

    align-items: center;
    justify-content: space-between;

    margin-bottom: 11px;
}

.featured-title {
    color: var(--orange);

    font-size: 23px;

    font-weight: 800;

    letter-spacing: -.5px;
}

.featured-subtitle {
    color: #777;

    font-size: 12px;
}

.featured-wrapper {
    position: relative;
}

.featured-track {
    display: flex;

    gap: 14px;

    overflow-x: auto;

    scroll-behavior: smooth;

    scrollbar-width: none;

    padding: 2px 2px 7px;

    scroll-snap-type: x mandatory;
}

.featured-track::-webkit-scrollbar {
    display: none;
}

.featured-card {
    position: relative;

    flex: 0 0 360px;

    min-height: 190px;

    display: flex;

    align-items: center;

    gap: 18px;

    padding: 19px;

    background:
        linear-gradient(
            145deg,
            #111 0%,
            #090909 65%,
            #0c0703 100%
        );

    border: 1px solid #292929;

    border-radius: 22px;

    overflow: hidden;

    scroll-snap-align: start;

    transition: .18s ease;
}

.featured-card:hover {
    border-color: rgba(255,122,0,.55);

    transform: translateY(-2px);
}

.featured-card::after {
    content: "";

    position: absolute;

    width: 170px;
    height: 170px;

    right: -70px;
    bottom: -90px;

    background: rgba(255,122,0,.08);

    border-radius: 50%;

    pointer-events: none;
}

.featured-icon {
    width: 112px;
    height: 112px;

    flex-shrink: 0;

    object-fit: cover;

    border-radius: 25px;

    background: #151515;

    border: 1px solid #303030;

    box-shadow:
        0 12px 28px rgba(0,0,0,.45);
}

.featured-content {
    min-width: 0;

    position: relative;

    z-index: 1;
}

.featured-name {
    font-size: 22px;

    font-weight: 850;

    color: #fff;

    margin-bottom: 4px;

    overflow-wrap: anywhere;
}

.featured-developer {
    color: var(--orange);

    font-size: 12px;

    font-weight: 700;

    margin-bottom: 9px;
}

.featured-description {
    color: #b9b9b9;

    font-size: 13px;

    line-height: 1.5;

    display: -webkit-box;

    -webkit-line-clamp: 3;

    -webkit-box-orient: vertical;

    overflow: hidden;
}

.featured-badge {
    display: inline-flex;

    margin-top: 10px;

    padding: 5px 8px;

    border-radius: 999px;

    background: rgba(255,122,0,.10);

    border: 1px solid rgba(255,122,0,.28);

    color: var(--orange);

    font-size: 10px;

    font-weight: 800;
}


/* =========================================================
   CATEGORY NAVIGATION
========================================================= */

.nav {
    display: flex;

    gap: 8px;

    overflow-x: auto;

    padding: 2px 1px 15px;

    scrollbar-width: none;
}

.nav::-webkit-scrollbar {
    display: none;
}

.category-btn {
    flex-shrink: 0;

    border: 1px solid #303030;

    background: #080808;

    color: var(--orange);

    border-radius: 999px;

    padding: 10px 15px;

    font-size: 13px;

    font-weight: 750;

    white-space: nowrap;

    cursor: pointer;

    transition: .18s ease;
}

.category-btn:hover {
    border-color: var(--orange);

    background: #120b05;
}

.category-btn.active {
    background: var(--orange);

    color: #000;

    border-color: var(--orange);

    box-shadow:
        0 5px 18px rgba(255,122,0,.15);
}


/* =========================================================
   PRODUCT VIEWS
========================================================= */

.view {
    display: block;
}

.view[hidden] {
    display: none;
}

.section-head {
    display: flex;

    align-items: end;

    justify-content: space-between;

    margin-bottom: 12px;
}

.section-head h2 {
    color: var(--orange);

    font-size: 23px;

    font-weight: 800;

    letter-spacing: -.4px;
}

.section-head p {
    color: #777;

    font-size: 12px;
}


/* =========================================================
   PRODUCT CARDS
========================================================= */

.package-list {
    display: grid;

    grid-template-columns:
        repeat(
            auto-fill,
            minmax(290px, 1fr)
        );

    gap: 14px;
}

.package-card {
    display: block;

    padding: 15px;

    background: #090909;

    border: 1px solid #242424;

    border-radius: 20px;

    transition: .18s ease;
}

.package-card:hover {
    transform: translateY(-2px);

    border-color:
        rgba(255,122,0,.55);

    box-shadow:
        0 12px 28px rgba(0,0,0,.55),
        0 0 0 1px rgba(255,122,0,.06);
}

.package-card[hidden] {
    display: none;
}

.package-card-top {
    display: flex;

    gap: 14px;
}

.package-icon {
    width: 68px;
    height: 68px;

    flex-shrink: 0;

    object-fit: cover;

    border-radius: 17px;

    background: #111;

    border: 1px solid #252525;
}

.package-main {
    min-width: 0;
}

.package-name {
    color: #fff;

    font-size: 18px;

    font-weight: 800;

    margin-bottom: 3px;

    overflow-wrap: anywhere;
}

.package-meta {
    color: #858585;

    font-size: 12px;

    line-height: 1.5;

    margin-bottom: 8px;
}

.package-summary {
    color: #d0d0d0;

    font-size: 13px;

    line-height: 1.55;

    overflow-wrap: anywhere;
}

.package-badges {
    display: flex;

    flex-wrap: wrap;

    gap: 6px;

    margin-top: 10px;
}

.tag {
    padding: 6px 8px;

    border-radius: 999px;

    background:
        rgba(255,122,0,.10);

    border:
        1px solid rgba(255,122,0,.28);

    color: var(--orange);

    font-size: 11px;

    font-weight: 750;
}


/* =========================================================
   EMPTY
========================================================= */

.empty {
    display: none;

    padding: 30px;

    text-align: center;

    color: #888;

    background: #090909;

    border: 1px solid #242424;

    border-radius: 18px;
}

.category-empty {
    display: none;

    padding: 42px 28px;

    text-align: center;

    color: #888;

    background: #090909;

    border: 1px solid #242424;

    border-radius: 20px;
}

.category-empty strong {
    display: block;

    color: var(--orange);

    font-size: 18px;

    margin-bottom: 7px;
}

.category-empty span {
    font-size: 13px;
}


/* =========================================================
   FOOTER
========================================================= */

.footer {
    margin-top: 35px;

    padding:
        28px
        10px
        18px;

    text-align: center;

    color: #707070;

    font-size: 12px;

    border-top: 1px solid #151515;
}

.footer-links {
    display: flex;

    align-items: center;

    justify-content: center;

    flex-wrap: wrap;

    gap: 18px;

    margin-bottom: 15px;
}

.footer-link {
    color: #aaa;

    transition: .18s ease;
}

.footer-link:hover {
    color: var(--orange);
}

.footer-x {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    color: #aaa;

    transition: .18s ease;
}

.footer-x:hover {
    color: var(--orange);
}

.x-icon {
    width: 14px;
    height: 14px;

    fill: currentColor;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:650px) {

    body {
        padding: 12px;
    }

    .topbar {
        height: 52px;
    }

    .brand {
        font-size: 18px;
    }

    .brand img {
        width: 36px;
        height: 36px;
    }

    .search-box {
        height: 46px;
    }

    .featured-card {
        flex-basis: 88vw;

        min-height: 175px;

        padding: 15px;

        gap: 14px;
    }

    .featured-icon {
        width: 92px;
        height: 92px;

        border-radius: 21px;
    }

    .featured-name {
        font-size: 19px;
    }

    .package-list {
        grid-template-columns: 1fr;
    }
}
</style>

<meta name="theme-color" content="#000000">
</head>


