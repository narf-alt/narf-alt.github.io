<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1">

<title>Narf Store</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    color-scheme: dark;
    --orange: #ff7a00;
    --orange-bright: #ff8a00;
    --black: #000000;
    --panel: #0b0b0b;
    --panel-2: #111111;
    --border: #242424;
    --text: #ffffff;
    --muted: #9a9a9a;
}

html {
    background: #000;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
        "Helvetica Neue", sans-serif;
    background: #000;
    color: var(--text);
    min-height: 100vh;
    padding: 18px;
}

a {
    text-decoration: none;
    color: inherit;
}

button,
input {
    font-family: inherit;
}

.page {
    max-width: 1120px;
    margin: auto;
}

/* =========================
   HEADER
========================= */

.topbar {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 800;
    font-size: 20px;
}

.brand img {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    object-fit: cover;
    background: #111;
}

.brand small {
    display: block;
    font-size: 11px;
    font-weight: 600;
    color: #8e8e93;
    margin-top: 2px;
}

.toplinks {
    display: flex;
    gap: 10px;
}

.toplink {
    padding: 9px 13px;
    border-radius: 12px;
    background: #0b0b0b;
    border: 1px solid #242424;
    color: #fff;
    font-size: 13px;
    font-weight: 650;
    transition: .18s ease;
}

.toplink:hover {
    border-color: var(--orange);
    color: var(--orange);
}

/* =========================
   HERO
========================= */

.hero {
    border-radius: 30px;
    padding: 34px;
    background:
        linear-gradient(
            145deg,
            #090909 0%,
            #050505 55%,
            #0b0703 100%
        );
    color: #fff;
    border: 1px solid #252525;
    box-shadow:
        0 20px 55px rgba(0,0,0,.55),
        inset 0 1px 0 rgba(255,255,255,.025);
    margin-bottom: 24px;
}

.hero h1 {
    font-size: 40px;
    letter-spacing: -1.2px;
    margin-bottom: 9px;
}

.hero p {
    max-width: 680px;
    color: rgba(255,255,255,.78);
    line-height: 1.6;
    font-size: 16px;
}

.hero-meta {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    margin-top: 20px;
}

.pill {
    padding: 8px 12px;
    border-radius: 999px;
    background: #111;
    border: 1px solid #292929;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
}

.pill:first-child {
    border-color: rgba(255,122,0,.45);
    color: var(--orange-bright);
}

/* =========================
   CATEGORY NAV
========================= */

.nav {
    display: flex;
    gap: 8px;
    overflow: auto;
    padding: 3px 1px 15px;
    scrollbar-width: none;
}

.nav::-webkit-scrollbar {
    display: none;
}

.nav button {
    border: 1px solid #303030;
    background: #080808;
    color: var(--orange);
    border-radius: 999px;
    padding: 10px 15px;
    font-size: 13px;
    font-weight: 750;
    white-space: nowrap;
    cursor: pointer;
    transition: .18s ease;
}

.nav button:hover {
    border-color: var(--orange);
    background: #120b05;
    color: var(--orange-bright);
}

.nav button.active {
    background: var(--orange);
    color: #000;
    border-color: var(--orange);
    box-shadow: 0 5px 18px rgba(255,122,0,.16);
}

/* =========================
   SEARCH
========================= */

.toolbar {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

.toolbar input {
    flex: 1;
    border: 1px solid #282828;
    border-radius: 15px;
    background: #080808;
    padding: 14px 16px;
    font-size: 14px;
    outline: none;
    color: #fff;
    transition: .18s ease;
}

.toolbar input::placeholder {
    color: #777;
}

.toolbar input:focus {
    border-color: var(--orange);
    box-shadow: 0 0 0 3px rgba(255,122,0,.08);
}

/* =========================
   VIEWS
========================= */

.view {
    display: block;
}

.view[hidden] {
    display: none;
}

/* =========================
   SECTION
========================= */

.section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 12px;
}

.section-head h2 {
    font-size: 23px;
    letter-spacing: -.4px;
    color: var(--orange);
}

.section-head p {
    font-size: 13px;
    color: #888;
}

/* =========================
   PRODUCTS
========================= */

.package-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 14px;
}

.package-card {
    display: block;
    background: #090909;
    border: 1px solid #242424;
    border-radius: 20px;
    padding: 15px;
    transition: .18s ease;
}

.package-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255,122,0,.55);
    box-shadow:
        0 12px 28px rgba(0,0,0,.55),
        0 0 0 1px rgba(255,122,0,.08);
}

.package-card[hidden] {
    display: none;
}

.package-card-top {
    display: flex;
    gap: 14px;
}

.package-icon {
    width: 68px;
    height: 68px;
    border-radius: 17px;
    object-fit: cover;
    flex-shrink: 0;
    background: #111;
    border: 1px solid #242424;
}

.package-main {
    min-width: 0;
}

.package-name {
    font-size: 18px;
    font-weight: 800;
    margin-bottom: 3px;
    color: #fff;
    overflow-wrap: anywhere;
}

.package-meta {
    font-size: 12px;
    color: #858585;
    line-height: 1.5;
    margin-bottom: 8px;
}

.package-summary {
    font-size: 13px;
    line-height: 1.55;
    color: #d0d0d0;
    overflow-wrap: anywhere;
}

.package-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
}

.tag {
    font-size: 11px;
    font-weight: 750;
    padding: 6px 8px;
    border-radius: 999px;
    background: rgba(255,122,0,.10);
    border: 1px solid rgba(255,122,0,.28);
    color: var(--orange);
}

/* =========================
   EMPTY
========================= */

.empty {
    display: none;
    padding: 28px;
    text-align: center;
    color: #888;
    background: #090909;
    border: 1px solid #242424;
    border-radius: 18px;
}

.category-empty {
    display: none;
    padding: 42px 28px;
    text-align: center;
    color: #888;
    background: #090909;
    border: 1px solid #242424;
    border-radius: 20px;
}

.category-empty strong {
    display: block;
    color: var(--orange);
    font-size: 18px;
    margin-bottom: 7px;
}

.category-empty span {
    font-size: 13px;
}

/* =========================
   FOOTER
========================= */

.footer {
    text-align: center;
    padding: 30px 10px 15px;
    color: #777;
    font-size: 12px;
}

.footer a {
    color: var(--orange);
}

.footer a:hover {
    color: var(--orange-bright);
}

/* =========================
   MOBILE
========================= */

@media(max-width:650px) {

    body {
        padding: 12px;
    }

    .hero {
        padding: 25px 20px;
        border-radius: 24px;
    }

    .hero h1 {
        font-size: 32px;
    }

    .toplinks .toplink:not(:last-child) {
        display: none;
    }

    .package-list {
        grid-template-columns: 1fr;
    }
}
</style>

<meta name="theme-color" content="#000000">
</head>

<body>

<div class="page">

<header class="topbar">

<a class="brand" href="https://{{repo_url}}">

<img src="icon.png" alt="NARF">

<span>
NARF
<small>Official Store</small>
</span>

</a>

<div class="toplinks">

<a class="toplink" href="https://x.com/narf_ios">
X @narf_ios
</a>

</div>

</header>


<section class="hero">

<h1>Narf Store</h1>

<p>
Discover themes, tweaks, apps and wallpapers from Narf
and independent developers — organized in one modern iOS marketplace.
</p>

<div class="hero-meta">

<span class="pill">
{{package_count}} products
</span>

<span class="pill">
iOS 15–26
</span>

<span class="pill">
Themes · Tweaks · Wallpapers · Apps
</span>

</div>

</section>


<nav class="nav">

<button
class="category-btn active"
data-category="popular">

🔥 Popular

</button>

<button
class="category-btn"
data-category="Themes">

🪶 Themes

</button>

<button
class="category-btn"
data-category="Tweaks">

🛠️ Tweaks

</button>

<button
class="category-btn"
data-category="Wallpapers">

🖼️ Wallpapers

</button>

<button
class="category-btn"
data-category="Apps">

📱 Apps

</button>

</nav>


<div class="toolbar">

<input
id="search-input"
type="search"
placeholder="Search products, developers or bundle IDs...">

</div>


<section id="popular-view" class="view">

<div class="section-head">

<div>

<h2>Popular</h2>

<p>
Products across the Narf Store
</p>

</div>

</div>


<div class="package-list">

{{#sections}}

{{#packages}}

<a
class="package-card package-entry"
href="depiction/web/{{bundle_id}}.html"
data-name="{{name}}"
data-bundle="{{bundle_id}}"
data-developer="{{developer.name}}"
data-section="{{section}}">

<div class="package-card-top">

<img
class="package-icon"
src="assets/{{bundle_id}}/icon.png"
alt="{{name}}">

<div class="package-main">

<div class="package-name">
{{name}}
</div>

<div class="package-meta">
{{developer.name}} · v{{version}} ·
iOS {{works_min}}–{{works_max}}
</div>

<div class="package-summary">
{{summary}}
</div>

<div class="package-badges">

<span class="tag">
{{section}}
</span>

</div>

</div>

</div>

</a>

{{/packages}}

{{/sections}}

</div>

</section>


{{#sections}}

<section
class="view category-view"
data-category-view="{{section_name}}"
hidden>

<div class="section-head">

<div>

<h2>
{{section_name}}
</h2>

<p>
Browse {{section_name}} products
</p>

</div>

</div>


<div class="package-list">

{{#packages}}

<a
class="package-card package-entry"
href="depiction/web/{{bundle_id}}.html"
data-name="{{name}}"
data-bundle="{{bundle_id}}"
data-developer="{{developer.name}}"
data-section="{{section}}">

<div class="package-card-top">

<img
class="package-icon"
src="assets/{{bundle_id}}/icon.png"
alt="{{name}}">

<div class="package-main">

<div class="package-name">
{{name}}
</div>

<div class="package-meta">
{{developer.name}} · v{{version}} ·
iOS {{works_min}}–{{works_max}}
</div>

<div class="package-summary">
{{summary}}
</div>

<div class="package-badges">

<span class="tag">
{{section}}
</span>

</div>

</div>

</div>

</a>

{{/packages}}

</div>

</section>

{{/sections}}


<div
id="category-empty"
class="category-empty">

<strong id="category-empty-title">
No products yet
</strong>

<span id="category-empty-text">
This category is ready for future products.
</span>

</div>


<div
id="empty-state"
class="empty">

No products match your search.

</div>


<footer class="footer">

{{footer}}
· Narf Store ·

<a href="https://x.com/narf_ios">
@narf_ios
</a>

</footer>

</div>


<script>

(function(){

var buttons =
[].slice.call(
document.querySelectorAll('.category-btn')
);

var popular =
document.getElementById('popular-view');

var views =
[].slice.call(
document.querySelectorAll('.category-view')
);

var search =
document.getElementById('search-input');

var empty =
document.getElementById('empty-state');

var categoryEmpty =
document.getElementById('category-empty');

var categoryEmptyTitle =
document.getElementById('category-empty-title');

var categoryEmptyText =
document.getElementById('category-empty-text');


function findView(category){

    var result = null;

    views.forEach(function(view){

        if (
            view.dataset.categoryView === category
        ) {
            result = view;
        }

    });

    return result;
}


function activate(category){

    buttons.forEach(function(button){

        button.classList.toggle(
            'active',
            button.dataset.category === category
        );

    });


    popular.hidden =
        category !== 'popular';


    var selectedView =
        findView(category);


    views.forEach(function(view){

        view.hidden =
            view !== selectedView;

    });


    if (
        category !== 'popular' &&
        !selectedView
    ) {

        categoryEmpty.style.display = 'block';

        categoryEmptyTitle.textContent =
            category + ' is coming soon';

        categoryEmptyText.textContent =
            'This category is ready for future products.';

    } else {

        categoryEmpty.style.display = 'none';

    }


    filter();

}


function filter(){

    var query =
        (search.value || '')
        .trim()
        .toLowerCase();


    var activeButton =
        document.querySelector(
            '.category-btn.active'
        );


    if (!activeButton) {
        return;
    }


    var active =
        activeButton.dataset.category;


    var root;


    if (active === 'popular') {

        root = popular;

    } else {

        root = findView(active);

    }


    if (!root) {

        empty.style.display = 'none';

        return;

    }


    var cards =
        [].slice.call(
            root.querySelectorAll('.package-entry')
        );


    var count = 0;


    cards.forEach(function(card){

        var haystack = [

            card.dataset.name || '',
            card.dataset.bundle || '',
            card.dataset.developer || '',
            card.dataset.section || ''

        ]
        .join(' ')
        .toLowerCase();


        var show =
            !query ||
            haystack.indexOf(query) !== -1;


        card.hidden = !show;


        if (show) {
            count++;
        }

    });


    if (count === 0) {

        if (active === 'popular') {

            empty.textContent =
                query
                ? 'No products match your search.'
                : 'No products are available yet.';

            empty.style.display = 'block';

        } else {

            categoryEmpty.style.display = 'block';

            categoryEmptyTitle.textContent =
                query
                ? 'No products match your search.'
                : active + ' is coming soon';

            categoryEmptyText.textContent =
                query
                ? 'Try another search term.'
                : 'This category is ready for future products.';

        }

    } else {

        empty.style.display = 'none';

        if (active !== 'popular') {
            categoryEmpty.style.display = 'none';
        }

    }

}


buttons.forEach(function(button){

    button.addEventListener(
        'click',
        function(){

            activate(
                button.dataset.category
            );

        }
    );

});


search.addEventListener(
    'input',
    filter
);


activate('popular');

})();

</script>


<script src="web/index.js"></script>

</body>
</html>
