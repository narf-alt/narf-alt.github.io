<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script>

(function() {


var buttons =
    [].slice.call(
        document.querySelectorAll('.category-btn')
    );


var popular =
    document.getElementById('popular-view');


var views =
    [].slice.call(
        document.querySelectorAll('.category-view')
    );


var search =
    document.getElementById('search-input');


var searchForm =
    document.getElementById('search-form');


var empty =
    document.getElementById('empty-state');


var categoryEmpty =
    document.getElementById('category-empty');


var categoryEmptyTitle =
    document.getElementById(
        'category-empty-title'
    );


var categoryEmptyText =
    document.getElementById(
        'category-empty-text'
    );


var featuredTrack =
    document.getElementById(
        'featured-track'
    );


function findView(category) {

    var result = null;

    views.forEach(function(view) {

        if (
            view.dataset.categoryView === category
        ) {

            result = view;

        }

    });

    return result;

}


function activate(category) {


    buttons.forEach(function(button) {

        button.classList.toggle(
            'active',
            button.dataset.category === category
        );

    });


    popular.hidden =
        category !== 'popular';


    var selectedView =
        findView(category);


    views.forEach(function(view) {

        view.hidden =
            view !== selectedView;

    });


    if (
        category !== 'popular' &&
        !selectedView
    ) {

        categoryEmpty.style.display =
            'block';


        categoryEmptyTitle.textContent =
            category + ' is coming soon';


        categoryEmptyText.textContent =
            'This category is ready for future products.';

    }

    else {

        categoryEmpty.style.display =
            'none';

    }


    filter();

}


function filter() {


    var query =
        (search.value || '')
        .trim()
        .toLowerCase();


    var activeButton =
        document.querySelector(
            '.category-btn.active'
        );


    if (!activeButton) {
        return;
    }


    var active =
        activeButton.dataset.category;


    var root;


    if (active === 'popular') {

        root = popular;

    }

    else {

        root = findView(active);

    }


    if (!root) {

        empty.style.display =
            'none';

        return;

    }


    var cards =
        [].slice.call(
            root.querySelectorAll(
                '.package-entry'
            )
        );


    var count = 0;


    cards.forEach(function(card) {


        var haystack = [

            card.dataset.name || '',
            card.dataset.bundle || '',
            card.dataset.developer || '',
            card.dataset.section || ''

        ]
        .join(' ')
        .toLowerCase();


        var show =
            !query ||
            haystack.indexOf(query) !== -1;


        card.hidden =
            !show;


        if (show) {
            count++;
        }

    });


    if (count === 0) {


        if (active === 'popular') {


            empty.textContent =
                query
                ? 'No products match your search.'
                : 'No products are available yet.';


            empty.style.display =
                'block';

        }

        else {


            categoryEmpty.style.display =
                'block';


            categoryEmptyTitle.textContent =
                query
                ? 'No products match your search.'
                : active + ' is coming soon';


            categoryEmptyText.textContent =
                query
                ? 'Try another search term.'
                : 'This category is ready for future products.';

        }

    }

    else {


        empty.style.display =
            'none';


        if (active !== 'popular') {

            categoryEmpty.style.display =
                'none';

        }

    }

}


buttons.forEach(function(button) {


    button.addEventListener(
        'click',
        function() {

            activate(
                button.dataset.category
            );

        }
    );

});


/*
    Search is intentionally NOT live.

    The user writes the search term,
    then presses the magnifying-glass button
    or Enter.
*/

searchForm.addEventListener(
    'submit',
    function(event) {

        event.preventDefault();

        filter();

    }
);


/*
    Featured carousel:
    horizontal swipe/scroll is native on iPhone.
*/

if (featuredTrack) {

    featuredTrack.addEventListener(
        'wheel',
        function(event) {

            if (
                Math.abs(event.deltaY) >
                Math.abs(event.deltaX)
            ) {

                event.preventDefault();

                featuredTrack.scrollLeft +=
                    event.deltaY;

            }

        },
        { passive: false }
    );

}


activate('popular');


})();

</script>


<script src="web/index.js"></script>

</body>
</html>
