<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#000000">
<title>NARF</title>

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    color-scheme: dark;
    --bg: #000;
    --surface: #0b0b0b;
    --surface-2: #131313;
    --line: #222;
    --line-2: #343434;
    --text: #f5f5f7;
    --text-2: #b4b4b9;
    --muted: #7d7d83;
    --orange: #ff7a00;
    --orange-hi: #ff9124;
    --orange-soft: rgba(255,122,0,.12);
    --orange-line: rgba(255,122,0,.34);
    --r-lg: 24px;
    --r-md: 16px;
    --ease: cubic-bezier(.2,.8,.2,1);
}

html { background: var(--bg); -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

body {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    background:
        radial-gradient(70% 38% at 85% 0%, rgba(255,122,0,.12), transparent 70%),
        var(--bg);
    background-repeat: no-repeat;
    color: var(--text);
    min-height: 100vh;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
    padding:
        calc(14px + env(safe-area-inset-top))
        calc(16px + env(safe-area-inset-right))
        calc(14px + env(safe-area-inset-bottom))
        calc(16px + env(safe-area-inset-left));
}

a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }
button, input { font: inherit; color: inherit; }
button { -webkit-tap-highlight-color: transparent; }
:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }

.page { width: 100%; max-width: 1180px; margin: 0 auto; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* ---------- Header ---------- */
.topbar { height: 64px; display: flex; align-items: center; justify-content: space-between; position: relative; }

.brand {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 26px; font-weight: 900; letter-spacing: -.02em;
    color: #fff; min-height: 48px;
}
.brand-mark {
    height: 42px; width: 42px;
    display: block; object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(255,122,0,.45));
}

.account-wrap { position: relative; }

.icon-btn {
    width: 44px; height: 44px; display: grid; place-items: center;
    border-radius: 50%; background: var(--surface);
    border: 1px solid var(--line-2); cursor: pointer;
    transition: border-color .18s var(--ease), transform .12s var(--ease);
}
.icon-btn:hover, .icon-btn.on { border-color: var(--orange); }
.icon-btn:active { transform: scale(.94); }
.icon-btn svg { width: 21px; height: 21px; }

.account-menu {
    position: absolute; right: 0; top: calc(100% + 8px);
    width: 270px; z-index: 30;
    background: var(--surface-2);
    border: 1px solid var(--line-2);
    border-radius: var(--r-md);
    padding: 8px;
    box-shadow: 0 18px 40px rgba(0,0,0,.75);
}
.account-menu[hidden] { display: none; }
.account-menu-head { padding: 10px 10px 12px; border-bottom: 1px solid var(--line); margin-bottom: 6px; }
.account-menu-head strong { display: block; font-size: 15px; }
.account-menu-head span { font-size: 12px; color: var(--muted); }
.account-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 10px; border-radius: 10px; font-size: 14px; color: var(--text-2);
}
.account-item small { font-size: 11px; color: var(--muted); }

/* ---------- Search ---------- */
.search { margin: 4px 0 24px; }
.search-box {
    display: flex; align-items: center; gap: 6px;
    height: 56px; padding: 0 5px 0 20px;
    background: var(--surface); border: 1px solid var(--line-2); border-radius: 999px;
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease);
}
.search-box:focus-within { border-color: var(--orange); box-shadow: 0 0 0 4px rgba(255,122,0,.12); }
.search-input {
    flex: 1; min-width: 0; height: 100%;
    background: transparent; border: 0; outline: 0; font-size: 16px;
}
.search-input::placeholder { color: #6c6c72; }
.search-input::-webkit-search-cancel-button { -webkit-appearance: none; }
.search-btn {
    height: 46px; padding: 0 22px; display: inline-flex; align-items: center; gap: 8px;
    background: var(--orange); color: #000; border: 0; border-radius: 999px;
    font-weight: 800; font-size: 14px; cursor: pointer;
    transition: background .18s var(--ease), transform .12s var(--ease);
}
.search-btn:hover { background: var(--orange-hi); }
.search-btn:active { transform: scale(.96); }
.search-btn svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; }

/* ---------- Section headers ---------- */
.head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.head h2 { font-size: 28px; font-weight: 850; letter-spacing: -.03em; }
.head p { color: var(--muted); font-size: 13px; margin-top: 2px; }

.arrows { display: none; gap: 8px; }
@media (hover: hover) and (pointer: fine) { .arrows { display: flex; } }
.arrow { width: 38px; height: 38px; }
.arrow svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

/* ---------- Featured ---------- */
.featured { margin-bottom: 26px; }
.featured[hidden] { display: none; }
.feat-track {
    display: flex; gap: 14px; overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scrollbar-width: none;
    margin: 0 calc(-16px - env(safe-area-inset-right)) 0 calc(-16px - env(safe-area-inset-left));
    padding: 4px calc(16px + env(safe-area-inset-right)) 8px calc(16px + env(safe-area-inset-left));
    scroll-padding-inline: 16px; -webkit-overflow-scrolling: touch;
}
.feat-track::-webkit-scrollbar { display: none; }
.feat {
    position: relative; flex: 0 0 min(86vw, 380px); scroll-snap-align: start;
    display: flex; flex-direction: column; gap: 18px; padding: 20px; min-height: 236px;
    border-radius: var(--r-lg); border: 1px solid var(--line-2);
    background: radial-gradient(120% 90% at 100% 100%, rgba(255,122,0,.2), transparent 60%), var(--surface);
    overflow: hidden;
    transition: transform .22s var(--ease), border-color .22s var(--ease);
}
.feat:hover { transform: translateY(-3px); border-color: var(--orange-line); }
.feat:active { transform: scale(.985); }
.feat-top { display: flex; gap: 16px; align-items: center; }
.feat .icon { width: 92px; height: 92px; border-radius: 21px; }
.feat-name { font-size: 22px; font-weight: 850; letter-spacing: -.02em; overflow-wrap: anywhere; }
.feat-dev { color: var(--orange); font-size: 13px; font-weight: 700; margin-top: 2px; }
.feat-desc {
    color: var(--text-2); font-size: 14px; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere;
}
.feat-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: auto; }
.pkg-meta { display: flex; flex-wrap: wrap; gap: 6px; }

/* ---------- Category nav ---------- */
.cats {
    position: sticky; top: 0; z-index: 10;
    margin: 0 calc(-16px - env(safe-area-inset-right)) 18px calc(-16px - env(safe-area-inset-left));
    padding: 8px calc(16px + env(safe-area-inset-right)) 8px calc(16px + env(safe-area-inset-left));
    background: linear-gradient(#000 70%, rgba(0,0,0,0));
}
.cats-row { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
.cats-row::-webkit-scrollbar { display: none; }
.cat {
    flex: 0 0 auto; min-height: 44px; display: inline-flex; align-items: center; gap: 8px;
    padding: 0 18px; background: var(--surface); border: 1px solid var(--line-2); border-radius: 999px;
    color: var(--text-2); font-size: 14px; font-weight: 700; white-space: nowrap; cursor: pointer;
    transition: background .2s var(--ease), color .2s var(--ease), border-color .2s var(--ease), transform .12s var(--ease);
}
.cat:hover { border-color: var(--orange-line); color: #fff; }
.cat:active { transform: scale(.96); }
.cat[aria-pressed="true"] { background: var(--orange); border-color: var(--orange); color: #000; }

/* ---------- Havoc-style shelf: 3 rows per column, swipe sideways, all in ONE box ---------- */
.shelf {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(0,0,0,.45);
}
.shelf[hidden] { display: none; }

.list {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(3, auto);
    grid-auto-columns: calc(100% - 30px);
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 6px 0;
}
.list::-webkit-scrollbar { display: none; }

.pkg {
    position: relative; scroll-snap-align: start;
    display: flex; align-items: center; gap: 14px;
    padding: 14px 16px; min-height: 92px;
    transition: background .18s var(--ease);
}
.pkg[hidden] { display: none; }
.pkg:hover { background: rgba(255,122,0,.05); }
.pkg:active { background: rgba(255,122,0,.09); }
.pkg::after {
    content: ""; position: absolute; left: 92px; right: 16px; bottom: 0;
    height: 1px; background: var(--line);
}
.pkg .icon { width: 62px; height: 62px; border-radius: 14px; }
.pkg-main { flex: 1; min-width: 0; }
.pkg-name { font-size: 17px; font-weight: 800; letter-spacing: -.015em; overflow-wrap: anywhere; }
.pkg-desc {
    color: var(--text-2); font-size: 13px; line-height: 1.4; margin-top: 2px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere;
}
.pkg-sub { color: var(--muted); font-size: 12px; margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.dots { display: flex; justify-content: center; gap: 7px; padding: 4px 0 14px; min-height: 22px; }
.dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--line-2); transition: background .2s var(--ease), width .2s var(--ease); }
.dots i.on { background: var(--orange); width: 18px; border-radius: 99px; }

/* Shared bits */
.icon {
    flex-shrink: 0; object-fit: cover; background: var(--surface-2);
    border: 1px solid var(--line-2); box-shadow: 0 8px 20px rgba(0,0,0,.45); display: block;
}
.icon.ph {
    display: grid; place-items: center; font-weight: 900; font-size: 26px; color: var(--orange);
    background: linear-gradient(145deg, #1a1a1a, #0d0d0d);
}
.chip {
    display: inline-flex; align-items: center; padding: 5px 10px; border-radius: 999px;
    font-size: 12px; font-weight: 700; line-height: 1.2; color: var(--text-2);
    background: var(--surface-2); border: 1px solid var(--line);
}
.chip.cat-chip { color: var(--orange); background: var(--orange-soft); border-color: var(--orange-line); }

.cta {
    flex-shrink: 0; min-width: 68px; min-height: 36px; display: inline-grid; place-items: center;
    padding: 0 16px; border-radius: 999px;
    background: var(--orange-soft); border: 1px solid var(--orange-line);
    color: var(--orange); font-size: 14px; font-weight: 850; letter-spacing: .01em;
    transition: background .18s var(--ease), color .18s var(--ease);
}
.pkg:hover .cta, .feat:hover .cta { background: var(--orange); color: #000; }
.cta.paid { font-variant-numeric: tabular-nums; }

/* ---------- Empty states ---------- */
.state {
    display: none; text-align: center; padding: 56px 24px;
    background: var(--surface); border: 1px dashed var(--line-2); border-radius: var(--r-lg);
}
.state.on { display: block; }
.state svg { width: 40px; height: 40px; margin-bottom: 14px; fill: none; stroke: var(--orange); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.state strong { display: block; font-size: 18px; margin-bottom: 6px; }
.state span { color: var(--muted); font-size: 14px; }
.state button {
    margin-top: 18px; min-height: 44px; padding: 0 20px; background: transparent;
    border: 1px solid var(--orange-line); border-radius: 999px; color: var(--orange); font-weight: 700; cursor: pointer;
}
.state button[hidden] { display: none; }

/* ---------- Footer ---------- */
.footer { margin-top: 56px; padding-top: 30px; border-top: 1px solid var(--line); }
.footer-grid { display: grid; gap: 26px 20px; grid-template-columns: repeat(2, 1fr); }
.footer h3 { font-size: 13px; font-weight: 800; color: var(--text); margin-bottom: 10px; }
.flink {
    display: block; width: 100%; text-align: left; padding: 8px 0; min-height: 36px;
    font-size: 14px; color: var(--muted); background: none; border: 0; cursor: pointer;
    transition: color .18s var(--ease);
}
.flink:hover { color: var(--orange); }
.footer-bottom {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px;
    margin-top: 28px; padding: 18px 0 6px; border-top: 1px solid var(--line);
    color: var(--muted); font-size: 12px;
}
.x-link {
    width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%;
    background: var(--surface); border: 1px solid var(--line-2); color: var(--text-2);
    transition: color .18s var(--ease), border-color .18s var(--ease), transform .12s var(--ease);
}
.x-link:hover { color: var(--orange); border-color: var(--orange); }
.x-link:active { transform: scale(.94); }
.x-link svg { width: 22px; height: 22px; fill: currentColor; }

/* Toast */
.toast {
    position: fixed; left: 50%; bottom: calc(24px + env(safe-area-inset-bottom)); z-index: 50;
    transform: translate(-50%, 20px); opacity: 0; pointer-events: none;
    background: var(--surface-2); border: 1px solid var(--orange-line); color: var(--text);
    padding: 12px 20px; border-radius: 999px; font-size: 14px; font-weight: 600;
    transition: opacity .25s var(--ease), transform .25s var(--ease);
}
.toast.on { opacity: 1; transform: translate(-50%, 0); }

/* ---------- Larger screens ---------- */
@media (min-width: 700px) {
    body { padding-left: 28px; padding-right: 28px; }
    .feat-track { margin: 0; padding-left: 0; padding-right: 0; scroll-padding-inline: 0; }
    .cats { margin: 0 0 18px; padding-left: 0; padding-right: 0; }
    .list { grid-auto-columns: 420px; }
    .footer-grid { grid-template-columns: repeat(5, 1fr); }
    .head h2 { font-size: 32px; }
}
@media (max-width: 420px) {
    .search-btn span { display: none; }
    .search-btn { padding: 0; width: 46px; justify-content: center; }
    .feat .icon { width: 78px; height: 78px; border-radius: 18px; }
}
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
}
</style>
</head>

<body>
<div class="page">

<!-- ================= HEADER ================= -->
<header class="topbar">

    <a class="brand" href="https://{{repo_url}}" aria-label="NARF home">
        <img class="brand-mark" src="data:image/png;base64," alt="" width="42" height="42">
        <span>NARF</span>
    </a>

    <div class="account-wrap">
        <button class="icon-btn" id="account-btn" type="button"
                aria-label="Account" aria-haspopup="true" aria-expanded="false" aria-controls="account-menu">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="8" r="3.6" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <path d="M5.4 19.4c.9-3.2 3.2-4.9 6.6-4.9s5.7 1.7 6.6 4.9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
        </button>
        <div class="account-menu" id="account-menu" role="menu" hidden>
            <div class="account-menu-head">
                <strong>Account</strong>
                <span>Sign-in is not available yet.</span>
            </div>
            <div class="account-item" role="menuitem" aria-disabled="true">Subscription <small>Soon</small></div>
            <div class="account-item" role="menuitem" aria-disabled="true">Purchases <small>Soon</small></div>
            <div class="account-item" role="menuitem" aria-disabled="true">Entitlements <small>Soon</small></div>
            <div class="account-item" role="menuitem" aria-disabled="true">Settings <small>Soon</small></div>
        </div>
    </div>

</header>

<!-- ================= SEARCH ================= -->
<section class="search" aria-label="Search">
    <form id="search-form" class="search-box" role="search">
        <label class="sr-only" for="search-input">Search packages</label>
        <input id="search-input" class="search-input" type="search"
               placeholder="Search packages, developers, bundle IDs"
               autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="search">
        <button class="search-btn" type="submit" aria-label="Search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.2"/><path d="M15.5 15.5L21 21"/></svg>
            <span>Search</span>
        </button>
    </form>
</section>

<!-- ================= FEATURED ================= -->
<section class="featured" id="featured" aria-labelledby="featured-title">
    <div class="head">
        <div>
            <h2 id="featured-title">Featured</h2>
            <p>Hand-picked from the Source</p>
        </div>
        <div class="arrows">
            <button class="icon-btn arrow" id="feat-prev" type="button" aria-label="Previous">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
            </button>
            <button class="icon-btn arrow" id="feat-next" type="button" aria-label="Next">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
            </button>
        </div>
    </div>

    <div class="feat-track" id="feat-track" tabindex="0" aria-label="Featured packages">
{{#sections}}
{{#packages}}
        <a class="feat" href="depiction/web/{{bundle_id}}.html">
            <div class="feat-top">
                <img class="icon" src="assets/{{bundle_id}}/icon.png" alt="" width="92" height="92" loading="lazy">
                <div>
                    <div class="feat-name">{{name}}</div>
                    <div class="feat-dev">{{developer.name}}</div>
                </div>
            </div>
            <div class="feat-desc">{{summary}}</div>
            <div class="feat-foot">
                <div class="pkg-meta">
                    <span class="chip cat-chip">{{section}}</span>
                    <span class="chip">v{{version}}</span>
                </div>
                <span class="cta {{#price}}paid{{/price}}">{{#price}}{{price}}{{/price}}{{^price}}GET{{/price}}</span>
            </div>
        </a>
{{/packages}}
{{/sections}}
    </div>
</section>

<!-- ================= CATEGORIES ================= -->
<nav class="cats" aria-label="Categories">
    <div class="cats-row" id="cats-row">
        <button class="cat" type="button" data-cat="popular" aria-pressed="true">
            <span aria-hidden="true">🔥</span>Popular
        </button>
    </div>
</nav>

<!-- ================= PRODUCTS ================= -->
<main>
    <div class="head">
        <div>
            <h2 id="view-title">Popular</h2>
            <p id="view-sub"></p>
        </div>
    </div>

    <div class="shelf" id="shelf">
        <div class="list" id="list" aria-live="polite">
{{#sections}}
{{#packages}}
            <a class="pkg"
               href="depiction/web/{{bundle_id}}.html"
               data-name="{{name}}"
               data-bundle="{{bundle_id}}"
               data-developer="{{developer.name}}"
               data-section="{{section}}"
               data-summary="{{summary}}">
                <img class="icon" src="assets/{{bundle_id}}/icon.png" alt="" width="62" height="62" loading="lazy">
                <div class="pkg-main">
                    <div class="pkg-name">{{name}}</div>
                    <div class="pkg-desc">{{summary}}</div>
                    <div class="pkg-sub">{{developer.name}} · v{{version}} · iOS {{works_min}}–{{works_max}}</div>
                </div>
                <span class="cta {{#price}}paid{{/price}}">{{#price}}{{price}}{{/price}}{{^price}}GET{{/price}}</span>
            </a>
{{/packages}}
{{/sections}}
        </div>
        <div class="dots" id="dots" aria-hidden="true"></div>
    </div>

    <div class="state" id="state">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>
        </svg>
        <strong id="state-title">No products yet</strong>
        <span id="state-text">This category is ready for future releases.</span>
        <div><button type="button" id="state-clear" hidden>Clear search</button></div>
    </div>
</main>

<!-- ================= FOOTER ================= -->
<footer class="footer">
    <div class="footer-grid">
        <div class="footer-col">
            <h3>Store</h3>
            <a class="flink" href="https://{{repo_url}}">Home</a>
        </div>
        <div class="footer-col">
            <h3>Account</h3>
            <button class="flink" type="button" data-open-account>Sign in</button>
        </div>
        <div class="footer-col">
            <h3>Purchases</h3>
            <button class="flink" type="button" data-open-account>Order history</button>
        </div>
        <div class="footer-col">
            <h3>Support</h3>
            <a class="flink" href="https://x.com/narf_ios" target="_blank" rel="noopener">Contact us</a>
        </div>
        <div class="footer-col">
            <h3>Developers</h3>
            <button class="flink" type="button" data-toast="Publishing with NARF is coming soon">Publish with NARF</button>
        </div>
    </div>

    <div class="footer-bottom">
        <a class="x-link" href="https://x.com/narf_ios" target="_blank" rel="noopener" aria-label="NARF on X">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
        </a>
        <span>{{footer}}</span>
    </div>
</footer>

</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(function () {
    var cards = [].slice.call(document.querySelectorAll('.pkg'));
    var list = document.getElementById('list');
    var shelf = document.getElementById('shelf');
    var dots = document.getElementById('dots');
    var state = document.getElementById('state');
    var stateTitle = document.getElementById('state-title');
    var stateText = document.getElementById('state-text');
    var stateClear = document.getElementById('state-clear');
    var viewTitle = document.getElementById('view-title');
    var viewSub = document.getElementById('view-sub');
    var catsRow = document.getElementById('cats-row');
    var form = document.getElementById('search-form');
    var input = document.getElementById('search-input');
    var featured = document.getElementById('featured');
    var track = document.getElementById('feat-track');
    var toast = document.getElementById('toast');

    /* ---------- Icon fallback ---------- */
    function placeholder(img) {
        if (img.dataset.ph) return;
        img.dataset.ph = '1';
        var d = document.createElement('div');
        d.className = img.className + ' ph';
        d.setAttribute('aria-hidden', 'true');
        d.style.width = img.getAttribute('width') + 'px';
        d.style.height = img.getAttribute('height') + 'px';
        var host = img.closest('.pkg, .feat');
        var n = host && (host.dataset.name || (host.querySelector('.feat-name') || {}).textContent) || '';
        d.textContent = (n.trim().charAt(0) || '·').toUpperCase();
        img.parentNode.replaceChild(d, img);
    }
    [].slice.call(document.querySelectorAll('img.icon')).forEach(function (img) {
        if (img.complete && img.naturalWidth === 0) placeholder(img);
    });
    document.addEventListener('error', function (e) {
        if (e.target && e.target.tagName === 'IMG' && e.target.classList.contains('icon')) placeholder(e.target);
    }, true);

    /* ---------- Categories ---------- */
    var ICONS = { themes: '🪶', tweaks: '🛠️', wallpapers: '🖼️', apps: '📱' };
    var ORDER = ['Themes', 'Tweaks', 'Wallpapers', 'Apps'];
    var cats = [];
    var seen = {};

    function addCat(label) {
        var key = label.toLowerCase();
        if (!label || seen[key]) return;
        seen[key] = true;
        cats.push({ key: key, label: label });
    }
    ORDER.forEach(addCat);
    cards.forEach(function (c) { addCat((c.dataset.section || '').trim()); });

    cats.forEach(function (c) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'cat';
        b.dataset.cat = c.key;
        b.setAttribute('aria-pressed', 'false');
        b.innerHTML = '<span aria-hidden="true">' + (ICONS[c.key] || '📦') + '</span>';
        b.appendChild(document.createTextNode(c.label));
        catsRow.appendChild(b);
    });

    function labelFor(key) {
        for (var i = 0; i < cats.length; i++) if (cats[i].key === key) return cats[i].label;
        return key;
    }

    cards.forEach(function (c) {
        c.dataset.hay = [c.dataset.name, c.dataset.bundle, c.dataset.developer, c.dataset.section, c.dataset.summary].join(' ').toLowerCase();
    });

    /* ---------- Page dots for the shelf (3 items per page) ---------- */
    var pages = 0;
    function buildDots(shown) {
        pages = Math.ceil(shown / 3);
        dots.innerHTML = '';
        if (pages < 2) return;
        for (var i = 0; i < pages; i++) dots.appendChild(document.createElement('i'));
        updateDots();
    }
    function updateDots() {
        if (pages < 2) return;
        var first = cards.filter(function (c) { return !c.hidden; })[0];
        if (!first) return;
        var w = first.offsetWidth || 1;
        var idx = Math.min(pages - 1, Math.max(0, Math.round(list.scrollLeft / w)));
        [].slice.call(dots.children).forEach(function (d, i) { d.className = i === idx ? 'on' : ''; });
    }
    list.addEventListener('scroll', function () { window.requestAnimationFrame(updateDots); }, { passive: true });
    window.addEventListener('resize', updateDots);

    /* ---------- Render ---------- */
    var cat = 'popular';
    var query = '';

    function render() {
        var q = query.toLowerCase();
        var shown = 0;

        cards.forEach(function (c) {
            var inCat = cat === 'popular' || cat === 'all' || (c.dataset.section || '').toLowerCase() === cat;
            var ok = inCat && (!q || c.dataset.hay.indexOf(q) !== -1);
            c.hidden = !ok;
            if (ok) shown++;
        });

        [].slice.call(catsRow.children).forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.dataset.cat === cat));
        });

        featured.hidden = !(cat === 'popular' && !q && track && track.children.length);

        if (q) {
            viewTitle.textContent = 'Results';
            viewSub.textContent = shown + (shown === 1 ? ' product' : ' products') + ' for \u201C' + query + '\u201D';
        } else if (cat === 'popular') {
            viewTitle.textContent = 'Popular';
            viewSub.textContent = shown ? 'Swipe sideways for more' : '';
        } else {
            viewTitle.textContent = labelFor(cat);
            viewSub.textContent = shown ? shown + (shown === 1 ? ' product' : ' products') : '';
        }

        shelf.hidden = shown === 0;
        list.scrollLeft = 0;
        buildDots(shown);

        state.classList.toggle('on', shown === 0);
        stateClear.hidden = !q;
        if (shown === 0) {
            if (q) {
                stateTitle.textContent = 'No results';
                stateText.textContent = 'Check the spelling or try a name, developer or bundle ID.';
            } else {
                stateTitle.textContent = 'No products yet';
                stateText.textContent = cat === 'popular' ? 'New releases will show up here.' : 'This category is ready for future releases.';
            }
        }
    }

    catsRow.addEventListener('click', function (e) {
        var b = e.target.closest('.cat');
        if (!b) return;
        cat = b.dataset.cat;
        query = '';
        input.value = '';
        render();
        b.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        query = input.value.trim();
        cat = query ? 'all' : 'popular';
        render();
        input.blur();
    });

    input.addEventListener('input', function () {
        if (input.value === '' && query) { query = ''; cat = 'popular'; render(); }
    });

    stateClear.addEventListener('click', function () {
        query = ''; cat = 'popular'; input.value = ''; render();
    });

    /* ---------- Featured arrows ---------- */
    function step(dir) {
        track.scrollBy({ left: dir * Math.max(280, track.clientWidth * 0.8), behavior: 'smooth' });
    }
    document.getElementById('feat-prev').addEventListener('click', function () { step(-1); });
    document.getElementById('feat-next').addEventListener('click', function () { step(1); });

    /* ---------- Account menu ---------- */
    var acBtn = document.getElementById('account-btn');
    var acMenu = document.getElementById('account-menu');
    function setMenu(open) {
        acMenu.hidden = !open;
        acBtn.setAttribute('aria-expanded', String(open));
        acBtn.classList.toggle('on', open);
    }
    acBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        setMenu(acMenu.hidden);
    });
    document.addEventListener('click', function (e) {
        if (!acMenu.hidden && !acMenu.contains(e.target)) setMenu(false);
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !acMenu.hidden) { setMenu(false); acBtn.focus(); }
    });

    /* Footer "Sign in" / "Order history": jump to top and open the account menu */
    [].slice.call(document.querySelectorAll('[data-open-account]')).forEach(function (el) {
        el.addEventListener('click', function (e) {
            e.stopPropagation();
            window.scrollTo({ top: 0, behavior: 'smooth' });
            setTimeout(function () { setMenu(true); }, 350);
        });
    });

    /* ---------- Toast ---------- */
    var tt;
    [].slice.call(document.querySelectorAll('[data-toast]')).forEach(function (el) {
        el.addEventListener('click', function () {
            toast.textContent = el.dataset.toast;
            toast.classList.add('on');
            clearTimeout(tt);
            tt = setTimeout(function () { toast.classList.remove('on'); }, 2200);
        });
    });

    render();
})();
</script>

<script src="web/index.js"></script>
</body>
</html>
